              args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w sitl_$(arg vehicle)_$(arg ID) $(arg px4_command_arg1)"/>
        <node pkg="mavros" type="mavros_node" name="mavros" required="true" clear_params="true" output="screen"
              launch-prefix="$(arg ready_gate) mavros $(arg vehicle) $(arg mavlink_tcp_base) $(arg startup_timeout)">
            <param name="fcu_url" value="$(arg fcu_url)"/>
            <param name="gcs_url" value=""/>
            <param name="target_system_id" value="$(eval 1 + arg('ID'))"/>
            <param name="target_component_id" value="1"/>
            <param name="fcu_protocol" value="v2.0"/>
            <rosparam command="load" file="$(find mavros)/launch/px4_pluginlists.yaml"/>
            <rosparam command="load" file="$(find mavros)/launch/px4_config.yaml"/>
        </node>
    </group>

    <group ns="typhoon_h480_3">
        <arg name="ID" value="3"/>
        <arg name="fcu_url" default="udp://:24543@localhost:34583"/>
        <env name="PX4_SIM_MODEL" value="$(arg vehicle)"/>
