        <param name="robotNamespace" value="$(arg vehicle)_$(arg ID)"/>
        <node name="sitl_$(arg ID)" pkg="px4" type="px4" output="screen"
              launch-prefix="$(arg ready_gate) px4 $(arg vehicle) $(arg mavlink_tcp_base) $(arg startup_timeout)"
              args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w sitl_$(arg vehicle)_$(arg ID) $(arg px4_command_arg1)"/>
        <node pkg="mavros" type="mavros_node" name="mavros" required="true" clear_params="true" output="screen"
              launch-prefix="$(arg ready_gate) mavros $(arg vehicle) $(arg mavlink_tcp_base) $(arg startup_timeout)">
