<?xml version="1.0"?>
<!-- 临时测试: 6 架 iris_2d_lidar 只 spawn 到 gazebo (不带 PX4/mavros),
     验证 gazebo 在多机 2D 雷达下是否崩溃. 与 typhoon_h480_depth 对照. -->
<launch>
  <arg name="world" default="$(find swarm_simulation)/worlds/reference/base0.world"/>
  <arg name="gui" default="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
  </include>

  <node name="spawn_iris_0" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_0 -x -14 -y -3 -z 0 -R 0 -P 0 -Y 0"/>
  <node name="spawn_iris_1" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_1 -x -14 -y 0 -z 0 -R 0 -P 0 -Y 0"/>
  <node name="spawn_iris_2" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_2 -x -14 -y 3 -z 0 -R 0 -P 0 -Y 0"/>
  <node name="spawn_iris_3" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_3 -x -17 -y -3 -z 0 -R 0 -P 0 -Y 0"/>
  <node name="spawn_iris_4" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_4 -x -17 -y 0 -z 0 -R 0 -P 0 -Y 0"/>
  <node name="spawn_iris_5" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find mavlink_sitl_gazebo)/models/iris_2d_lidar/iris_2d_lidar.sdf -model iris_lidar_5 -x -17 -y 3 -z 0 -R 0 -P 0 -Y 0"/>
</launch>
