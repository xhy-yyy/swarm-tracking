# Copy to config/runtime.env (local configuration, ignored by Git).
# Paths may contain spaces; shell-quote their values.
# PX4_DIR="/path/to/PX4-Autopilot"
# Python 3.10 vision interpreter; see docs/vision_environment.md.
# Get the absolute path with: conda run -n swarm-vision python -c 'import sys; print(sys.executable)'
# VISION_PYTHON="/path/to/vision/environment/bin/python"
# SWARM_WEIGHTS="/path/to/best_11s_new.pt"
